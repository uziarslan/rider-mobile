{
  "expo": {
    "name": "Cenciss Delivery",
    "slug": "cenciss-rider",
    "description": "Secure delivery operations, live rider tracking, and order coordination for Cenciss restaurants.",
    "version": "1.0.4",
    "icon": "./assets/icon.png",
    "primaryColor": "#2f66e8",
    "backgroundColor": "#ffffff",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "cencissrider",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cenciss.rider"
    },
    "android": {
      "package": "com.cenciss.rider",
      "versionCode": 8,
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/notification-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "Allow Cenciss Delivery to record your delivery route while you are on duty.",
          "locationAlwaysAndWhenInUsePermission": "Allow Cenciss Delivery to record your delivery route while you are on duty."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2f66e8",
          "defaultChannel": "rider-assignments"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 210,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-background-task"
    ],
    "extra": {
      "eas": {
        "projectId": "a036093c-d6e7-4b32-8566-2800ac23eb03"
      }
    }
  }
}
